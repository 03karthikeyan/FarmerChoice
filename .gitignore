# ==========================================
# Farmer Choice Project - Root .gitignore
# ==========================================

# Environment & Secrets (NEVER COMMIT)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.jks
*.keystore

# Node.js & Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# Admin Panel Build (React / Vite)
admin/dist/
admin/dist-ssr/
dist/
build/
.cache/

# Backend Uploads & Generated Media
backend/public/uploads/*
!backend/public/uploads/.gitkeep
backend/uploads/
uploads/

# Mobile (Flutter & Dart)
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub/
mobile/.pub-cache/
mobile/build/
mobile/coverage/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/

# Mobile - Android Specific
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/build/
mobile/android/captures/
mobile/android/gradlew
mobile/android/gradlew.bat
*.apk
*.aab
*.ap_

# Mobile - iOS Specific
mobile/ios/.symlinks/
mobile/ios/Pods/
mobile/ios/Podfile.lock
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/app.framework

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Temporary Files
logs/
*.log
*.tmp
*.bak
